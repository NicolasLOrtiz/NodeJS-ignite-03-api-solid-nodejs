    "@vitest/ui": "4.1.6",
    "eslint": "10.4.0",
    "npm-run-all": "4.1.5",
    "prisma": "7.8.0",
    "supertest": "7.1.0",
    "tsup": "8.5.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vite": "8.0.13",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.6"
